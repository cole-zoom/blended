{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "actions": {
    "camera.orbit": {
      "accepts": [
        "camera"
      ],
      "params": {
        "additionalProperties": false,
        "description": "Sweep the camera around a target, optionally rising and pulling away as it goes.\n\nImplemented as a rotating pivot with the camera parented to it. Azimuth is the pivot's\nrotation; elevation and distance are the camera's local position on that pivot. Keeping the\nsweep on a parent means a *constant-distance* orbit stays exactly circular no matter what\neasing is applied, rather than depending on interpolation between sampled positions.\n\nElevation and distance default to constant (end == start), so a plain orbit needs no extra\nparameters.",
        "properties": {
          "distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Base distance. Auto-framed from the asset when null.",
            "title": "Distance"
          },
          "easing": {
            "default": "ease_in_out",
            "enum": [
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "ease_in_strong",
              "ease_out_strong",
              "ease_in_out_strong",
              "drift_in",
              "drift_out",
              "drift_in_out",
              "overshoot_out",
              "overshoot_in_out"
            ],
            "title": "Easing",
            "type": "string"
          },
          "end_azimuth": {
            "default": 30.0,
            "title": "End Azimuth",
            "type": "number"
          },
          "end_distance_scale": {
            "default": 1.0,
            "description": "Multiplier at the end. >1 pulls the camera away.",
            "exclusiveMinimum": 0,
            "title": "End Distance Scale",
            "type": "number"
          },
          "end_elevation": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Defaults to start_elevation (constant height).",
            "title": "End Elevation"
          },
          "start_azimuth": {
            "default": -30.0,
            "description": "Degrees. 0 faces the asset head-on.",
            "title": "Start Azimuth",
            "type": "number"
          },
          "start_distance_scale": {
            "default": 1.0,
            "description": "Multiplier on the base distance at the start.",
            "exclusiveMinimum": 0,
            "title": "Start Distance Scale",
            "type": "number"
          },
          "start_elevation": {
            "default": 12.0,
            "description": "Degrees above the horizon.",
            "title": "Start Elevation",
            "type": "number"
          }
        },
        "title": "OrbitParams",
        "type": "object"
      },
      "tags": [
        "camera",
        "reveal",
        "cinematic"
      ],
      "timing": "stretchable",
      "writes": [
        "transform"
      ]
    },
    "light.ramp": {
      "accepts": [
        "light"
      ],
      "params": {
        "additionalProperties": false,
        "description": "Animate a light's energy. The goal's 'dim to bright'.",
        "properties": {
          "easing": {
            "default": "ease_in_out",
            "enum": [
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "ease_in_strong",
              "ease_out_strong",
              "ease_in_out_strong",
              "drift_in",
              "drift_out",
              "drift_in_out",
              "overshoot_out",
              "overshoot_in_out"
            ],
            "title": "Easing",
            "type": "string"
          },
          "end_energy": {
            "minimum": 0,
            "title": "End Energy",
            "type": "number"
          },
          "start_energy": {
            "minimum": 0,
            "title": "Start Energy",
            "type": "number"
          }
        },
        "required": [
          "start_energy",
          "end_energy"
        ],
        "title": "LightRampParams",
        "type": "object"
      },
      "tags": [
        "light",
        "reveal",
        "mood"
      ],
      "timing": "stretchable",
      "writes": [
        "energy"
      ]
    },
    "object.fade": {
      "accepts": [
        "asset"
      ],
      "params": {
        "additionalProperties": false,
        "description": "Animate a flat material's opacity.\n\nDistinct from `object.reveal`: a wipe uncovers an object with a moving edge, a fade changes\nhow present the whole of it is. The two multiply into the same alpha, so an object can be\ndoing both at once without either action knowing about the other.",
        "properties": {
          "easing": {
            "default": "ease_out_strong",
            "enum": [
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "ease_in_strong",
              "ease_out_strong",
              "ease_in_out_strong",
              "drift_in",
              "drift_out",
              "drift_in_out",
              "overshoot_out",
              "overshoot_in_out"
            ],
            "title": "Easing",
            "type": "string"
          },
          "end": {
            "default": 1.0,
            "maximum": 1,
            "minimum": 0,
            "title": "End",
            "type": "number"
          },
          "start": {
            "default": 0.0,
            "maximum": 1,
            "minimum": 0,
            "title": "Start",
            "type": "number"
          }
        },
        "title": "FadeParams",
        "type": "object"
      },
      "tags": [
        "object",
        "reveal",
        "2d"
      ],
      "timing": "stretchable",
      "writes": [
        "opacity"
      ]
    },
    "object.hold": {
      "accepts": [
        "asset",
        "camera",
        "light"
      ],
      "params": {
        "additionalProperties": false,
        "description": "Occupy a span without animating anything.\n\nExists so a gap in the timeline can be deliberate and visible in the IR rather than implied.",
        "properties": {},
        "title": "HoldParams",
        "type": "object"
      },
      "tags": [
        "timing"
      ],
      "timing": "stretchable",
      "writes": []
    },
    "object.morph": {
      "accepts": [
        "asset"
      ],
      "params": {
        "additionalProperties": false,
        "description": "Drive a shape key built at asset time by `morph_target`.\n\nOnly the blend value is animated here. The correspondence between the two outlines \u2014\ncontour pairing, resampling, winding and start-index alignment \u2014 is compiled once when the\nasset is built, so nothing expensive or non-deterministic happens per frame.",
        "properties": {
          "easing": {
            "default": "ease_in_out",
            "enum": [
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "ease_in_strong",
              "ease_out_strong",
              "ease_in_out_strong",
              "drift_in",
              "drift_out",
              "drift_in_out",
              "overshoot_out",
              "overshoot_in_out"
            ],
            "title": "Easing",
            "type": "string"
          },
          "end": {
            "default": 1.0,
            "maximum": 1,
            "minimum": 0,
            "title": "End",
            "type": "number"
          },
          "key": {
            "default": "morph",
            "description": "Shape key name.",
            "title": "Key",
            "type": "string"
          },
          "start": {
            "default": 0.0,
            "maximum": 1,
            "minimum": 0,
            "title": "Start",
            "type": "number"
          }
        },
        "title": "MorphParams",
        "type": "object"
      },
      "tags": [
        "object",
        "transform",
        "2d"
      ],
      "timing": "stretchable",
      "writes": [
        "shape"
      ]
    },
    "object.move": {
      "accepts": [
        "asset"
      ],
      "params": {
        "additionalProperties": false,
        "description": "Translate between two offsets, in units of the asset's normalised width.\n\nOffsets, not absolute positions: the asset is already centred, so its resting place is 0.\n`end_x: -0.404` reads as \"left by 40% of the wordmark's width\" and stays correct if the\nartwork is re-traced at a different size.",
        "properties": {
          "easing": {
            "default": "ease_in_out",
            "enum": [
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "ease_in_strong",
              "ease_out_strong",
              "ease_in_out_strong",
              "drift_in",
              "drift_out",
              "drift_in_out",
              "overshoot_out",
              "overshoot_in_out"
            ],
            "title": "Easing",
            "type": "string"
          },
          "end_x": {
            "default": 0.0,
            "description": "End offset, asset widths.",
            "title": "End X",
            "type": "number"
          },
          "end_z": {
            "default": 0.0,
            "title": "End Z",
            "type": "number"
          },
          "start_x": {
            "default": 0.0,
            "description": "Start offset, asset widths.",
            "title": "Start X",
            "type": "number"
          },
          "start_z": {
            "default": 0.0,
            "description": "Vertical start offset, asset widths.",
            "title": "Start Z",
            "type": "number"
          }
        },
        "title": "MoveParams",
        "type": "object"
      },
      "tags": [
        "object",
        "motion",
        "2d"
      ],
      "timing": "stretchable",
      "writes": [
        "transform"
      ]
    },
    "object.reveal": {
      "accepts": [
        "asset"
      ],
      "params": {
        "additionalProperties": false,
        "description": "Sweep a wipe edge across the target. Everything left of the edge is visible.\n\nPositions are asset widths from the asset's centre, so -0.5 is its left edge and +0.5 its\nright. Running `end_x` below `start_x` un-reveals, which is how the reverse beat is built\nwithout a second action.",
        "properties": {
          "easing": {
            "default": "ease_in_out",
            "enum": [
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "ease_in_strong",
              "ease_out_strong",
              "ease_in_out_strong",
              "drift_in",
              "drift_out",
              "drift_in_out",
              "overshoot_out",
              "overshoot_in_out"
            ],
            "title": "Easing",
            "type": "string"
          },
          "end_x": {
            "default": 0.5,
            "description": "Edge end, asset widths from centre.",
            "title": "End X",
            "type": "number"
          },
          "start_x": {
            "default": -0.5,
            "description": "Edge start, asset widths from centre.",
            "title": "Start X",
            "type": "number"
          }
        },
        "title": "RevealParams",
        "type": "object"
      },
      "tags": [
        "object",
        "reveal",
        "2d"
      ],
      "timing": "stretchable",
      "writes": [
        "wipe"
      ]
    },
    "object.spin": {
      "accepts": [
        "asset"
      ],
      "params": {
        "additionalProperties": false,
        "properties": {
          "axis": {
            "default": "z",
            "enum": [
              "x",
              "y",
              "z"
            ],
            "title": "Axis",
            "type": "string"
          },
          "easing": {
            "default": "linear",
            "enum": [
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "ease_in_strong",
              "ease_out_strong",
              "ease_in_out_strong",
              "drift_in",
              "drift_out",
              "drift_in_out",
              "overshoot_out",
              "overshoot_in_out"
            ],
            "title": "Easing",
            "type": "string"
          },
          "turns": {
            "default": 1.0,
            "title": "Turns",
            "type": "number"
          }
        },
        "title": "SpinParams",
        "type": "object"
      },
      "tags": [
        "object",
        "motion"
      ],
      "timing": "stretchable",
      "writes": [
        "transform"
      ]
    },
    "object.tint": {
      "accepts": [
        "asset"
      ],
      "params": {
        "additionalProperties": false,
        "description": "Fade a flat material's colour. Linear RGBA, not sRGB hex.",
        "properties": {
          "easing": {
            "default": "ease_in_out",
            "enum": [
              "linear",
              "ease_in",
              "ease_out",
              "ease_in_out",
              "ease_in_strong",
              "ease_out_strong",
              "ease_in_out_strong",
              "drift_in",
              "drift_out",
              "drift_in_out",
              "overshoot_out",
              "overshoot_in_out"
            ],
            "title": "Easing",
            "type": "string"
          },
          "end_color": {
            "default": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "End Color",
            "type": "array"
          },
          "start_color": {
            "default": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Start Color",
            "type": "array"
          }
        },
        "title": "TintParams",
        "type": "object"
      },
      "tags": [
        "object",
        "mood",
        "2d"
      ],
      "timing": "stretchable",
      "writes": [
        "color"
      ]
    }
  },
  "description": "The closed vocabulary a scene composes from. `writes` lists the channels an action animates; two tracks writing the same channel of the same target over overlapping frames is a CHANNEL_CONFLICT.",
  "title": "blended action library"
}
