    "Backdrop": {
      "additionalProperties": false,
      "description": "A flat card behind the subject, filling the frame.\n\nNot the world colour and not an HDRI. Both of those light the scene as well as being seen,\nwhich is wrong here twice over: a 2D scene has no lighting to contribute to, and the brand\nbackdrop is a specific photographic gradient rather than anything a colour or a procedural\nramp reproduces. A card is also the only one of the three that can be *animated* \u2014 moved,\nscaled or cross-faded \u2014 which later beats need.\n\nShadeless, like everything else in a 2D scene, so it renders as exactly the pixels of its\nsource image.",
      "properties": {
        "color": {
          "default": [
            1.0,
            1.0,
            1.0,
            1.0
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Color",
          "type": "array"
        },
        "distance": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Distance",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "overscan": {
          "default": 1.6,
          "minimum": 1.0,
          "title": "Overscan",
          "type": "number"
        },
        "strength": {
          "default": 1.0,
          "minimum": 0,
          "title": "Strength",
          "type": "number"
        }
      },
      "title": "Backdrop",
      "type": "object"
    },
