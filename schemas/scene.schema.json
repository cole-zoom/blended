    "DepthOfField": {
      "additionalProperties": false,
      "description": "Real lenses focus at one distance and blur everything else.\n\nIts absence is a strong \"CG\" tell \u2014 a perfectly sharp image at every depth is something no\nphysical camera produces. Focus tracks an empty at the subject, so it stays locked while the\ncamera moves rather than needing to be keyframed.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "f_stop": {
          "default": 4.0,
          "exclusiveMinimum": 0,
          "title": "F Stop",
          "type": "number"
        },
        "focus_offset": {
          "default": 0.0,
          "title": "Focus Offset",
          "type": "number"
        }
      },
      "title": "DepthOfField",
      "type": "object"
    },
