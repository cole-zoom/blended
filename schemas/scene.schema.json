  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A compiled animation. Authored by hand or by an agent; never contains bpy. Becomes the source of truth once a build succeeds \u2014 edits are patches, not regenerations.",
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    },
    "camera": {
      "$ref": "#/$defs/Camera"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "lights": {
      "items": {
        "$ref": "#/$defs/Light"
      },
      "title": "Lights",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "post": {
      "$ref": "#/$defs/Post"
    },
    "timeline": {
      "$ref": "#/$defs/Timeline"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/Track"
      },
      "title": "Tracks",
      "type": "array"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "world": {
      "$ref": "#/$defs/World"
    }
  },
  "required": [
    "name",
    "timeline",
    "assets"
  ],
  "title": "blended Scene IR",
  "type": "object"
}
