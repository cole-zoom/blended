    "Post": {
      "additionalProperties": false,
      "description": "Compositing applied after the render.\n\nReal optics scatter light inside the lens around bright sources, so highlights bloom. That\nsoftening is a strong \"photographed\" cue.",
      "properties": {
        "bloom": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Bloom",
          "type": "number"
        },
        "bloom_threshold": {
          "default": 1.0,
          "minimum": 0,
          "title": "Bloom Threshold",
          "type": "number"
        },
        "view_transform": {
          "default": "agx",
          "enum": [
            "agx",
            "standard",
            "filmic",
            "raw"
          ],
          "title": "View Transform",
          "type": "string"
        }
      },
      "title": "Post",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": false,
      "description": "The authoritative clock. Never derived from the animation (ARCHITECTURE \u00a73).",
      "properties": {
        "duration": {
          "description": "Seconds. The scene is exactly this long.",
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "number"
        },
        "fps": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "integer"
        }
      },
      "required": [
        "duration"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "Track": {
      "additionalProperties": false,
      "description": "One library action, scheduled on the timeline.\n\nThe agent writes these. It picks `action` from a closed vocabulary and fills `params` against\nthat action's schema \u2014 it never expresses motion as raw keyframes.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "number"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "start": {
          "default": 0.0,
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "action",
        "target",
        "duration"
      ],
      "title": "Track",
      "type": "object"
    },
    "Volumetrics": {
      "additionalProperties": false,
      "description": "Scattering medium that makes light shafts visible.\n\nImplemented as a bounded volume box, not a world volume \u2014 a world volume renders black in\nEEVEE 5.2 (see `staging.add_atmosphere`). Off by default: it is a real render cost and only\nearns it when there is a strong directional light with geometry to cast shafts through.",
      "properties": {
        "anisotropy": {
          "default": 0.4,
          "maximum": 1,
          "minimum": -1,
          "title": "Anisotropy",
          "type": "number"
        },
        "density": {
          "default": 0.12,
          "minimum": 0,
          "title": "Density",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "samples": {
          "default": 96,
          "exclusiveMinimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        }
      },
      "title": "Volumetrics",
      "type": "object"
    },
