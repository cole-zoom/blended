# Blender source clone — API oracle only, never vendored (345MB)
blender/

# The repo is the tool, not the work. Scenes, source art and renders are client- and
# machine-specific; publishing them is a leak waiting to happen and none of it is needed to
# build or test. Start a fresh machine with `blended new`, not with someone else's project.
projects/
goal/

# Belt-and-braces: never let a brief, a brand book or a stray asset in by accident.
*.pdf
*.mp4
*.mov

# Build output
out/
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env
.env
.env.local

# macOS
.DS_Store
