# Blender source clone — API oracle only, never vendored (345MB)
blender/

# Machine-local: heavy, regenerable, or specific to one person's session.
# Scene files and source art are NOT here — those are the actual work and must travel, or a
# fresh clone has nothing to open.
projects/*/renders/
projects/*/history/
projects/*/.stages.json
projects/*/*.resolved.json

# Build output
out/
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env
.env
.env.local

# macOS
.DS_Store
